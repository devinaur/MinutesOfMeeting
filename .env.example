APP_NAME="YIID Minutes of Meeting Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# System ODBC path on macOS Apple Silicon
# ODBCSYSINI=/opt/homebrew/etc

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL / PostgreSQL / SQLite / SQL Server)
DB_CONNECTION=sqlite
# For SQL Server:
# DB_CONNECTION=sqlsrv
# DB_HOST=127.0.0.1
# DB_PORT=1433
# DB_DATABASE=yiid_mom
# DB_USERNAME=sa
# DB_PASSWORD=StrongPassword123!
# DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@yiid.yusen-logistics.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# MoM AI Microservice Configuration
MOM_SERVICE_URL=http://127.0.0.1:8001
MOM_TIMEOUT_SECONDS=120

# Microsoft Copilot / Power Automate Integration (Dual Flow)
MOM_AI_DRIVER=auto
POWER_AUTOMATE_TEXT_URL=
POWER_AUTOMATE_AUDIO_URL=
POWER_AUTOMATE_API_KEY=
